{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aws-console",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "keep_vars": true,
  // 開啟 Workers Logs：instrumentation.ts 的 onRequestError 會把被遮蔽的
  // RSC 錯誤（digest/stack）寫入 console，可在 Dashboard 觀測。
  "observability": {
    "enabled": true
  },
  // opennextjs-cloudflare #1232：Workers 不支援 getMiddlewareManifest()
  // 的動態 require；本專案不使用 Next middleware（守衛在 layout 實作），
  // 以 minimal mode 跳過該路徑。
  "vars": {
    "NEXT_PRIVATE_MINIMAL_MODE": "1"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "aws-console"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      // 正式資料庫：與 Nuxt 版共用同一份 migrations，資料原樣沿用；
      // Worker 上的 secrets（CREDENTIAL_ENCRYPTION_KEY、SESSION_SECRET）
      // 在同名部署時保留，加密資料可直接解密。
      "database_name": "aws-console",
      "database_id": "95917b87-defb-4175-a060-875dc58d8796",
      "migrations_dir": "../server/db/migrations"
    }
  ]
}
